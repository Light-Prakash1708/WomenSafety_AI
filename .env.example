# Copy to .env and fill in from Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
# Where you host web/track (GitHub Pages works), e.g. https://yourname.github.io/saahi/track
EXPO_PUBLIC_TRACK_PAGE_URL=https://YOURNAME.github.io/saahi/track
# From `npx eas-cli@latest init` (needed for push notifications)
EXPO_PUBLIC_EAS_PROJECT_ID=
