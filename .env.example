# Only needed to run SAAHI on your own computer (npm run dev) against your Turso database.
# On Vercel these come from the Turso integration automatically.
# Leave both empty to use a local database file instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: turns on AI-written pattern summaries and the multilingual support guide.
# Without it SAAHI uses built-in summaries and curated answers.
ANTHROPIC_API_KEY=

# Phone app only: where the API lives. Defaults to https://womensafety-ai.vercel.app
EXPO_PUBLIC_API_URL=
# Phone app only: from `npx eas-cli@latest init`, needed for push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=
